generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  AUTOMATION
  WEB
  MOBILE
  SAAS
}

enum SnapshotReason {
  MANUAL_SAVE
  AI_EDIT
  INITIAL_GENERATION
  IMPORT
  RESTORE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id            String            @id @default(uuid())
  ownerId       String
  name          String
  description   String?
  type          ProjectType       @default(AUTOMATION)
  state         Json              @default("{}") // JSONB project state
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshots     ProjectSnapshot[]
  conversations Conversation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ProjectSnapshot {
  id        String         @id @default(uuid())
  projectId String
  state     Json
  reason    SnapshotReason @default(MANUAL_SAVE)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model Conversation {
  id        String                @id @default(uuid())
  projectId String
  title     String?
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
