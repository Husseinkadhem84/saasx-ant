{
    "name": "api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@prisma/client": "^5.22.0",
        "@saasx/shared": "*",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/supertest": "^7.2.1",
        "esbuild": "^0.25.0",
        "prisma": "^5.22.0",
        "supertest": "^7.2.2",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vitest": "^4.1.10"
    }
}
