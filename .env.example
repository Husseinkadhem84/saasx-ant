# Server Configuration
NODE_ENV="development"
PORT="3001"
CORS_ORIGIN="http://localhost:3000"

# Database
# DO NOT COMMIT REAL CREDENTIALS. Use Supabase pooled connection string in production.
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"

# Supabase Auth Configuration
# SUPABASE_ANON_KEY is not a severe secret like SERVICE_ROLE_KEY, but it should still be managed as configuration and not hardcoded.
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Rate Limiting
API_RATE_LIMIT_WINDOW_MS="900000"
API_RATE_LIMIT_MAX="100"
AI_RATE_LIMIT_WINDOW_MS="3600000"
AI_RATE_LIMIT_MAX="20"

# AI Provider (Optional for dev fallback)
GEMINI_API_KEY=""
